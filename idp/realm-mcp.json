{
  "realm": "mcp",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 600,
  "ssoSessionIdleTimeout": 3600,
  "defaultDefaultClientScopes": [
    "basic",
    "mcp:basic"
  ],
  "defaultOptionalClientScopes": [
    "payment-op"
  ],
  "clientScopes": [
    {
      "name": "basic",
      "description": "sub + preferred_username",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "mcp:basic",
      "description": "Baseline access to the MCP server (read balances, list payees)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Let the agent read your accounts through the MCP server"
      },
      "protocolMappers": [
        {
          "name": "mcp-server-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "http://mcp-server:3000/mcp",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "payment-op",
      "description": "Authorize ONE specific pending payment operation (dynamic scope payment-op:<operation-id>)",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Authorize the agent to execute this specific payment",
        "is.parameterized.scope": "true",
        "parameterized.scope.regexp": "payment-op:*"
      },
      "protocolMappers": [
        {
          "name": "mcp-server-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "http://mcp-server:3000/mcp",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "mcp-agent",
      "name": "MCP Step-Up Lab Agent",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8765/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "basic",
        "mcp:basic"
      ],
      "optionalClientScopes": [
        "payment-op"
      ]
    },
    {
      "clientId": "mcp-probe",
      "name": "curl probe (password grant, lab only)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "mcp:basic"
      ],
      "optionalClientScopes": [
        "payment-op"
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Lab",
      "email": "alice@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ]
    }
  ]
}
