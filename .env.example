# Copy to .env and fill in. Used only by the `agent` service.

# --- LLM provider: "anthropic" (Claude) or "openai" (any OpenAI-compatible server, e.g. a local model)
LLM_PROVIDER=anthropic

# Claude (LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local model (LLM_PROVIDER=openai), e.g. Ollama running natively on the Mac:
#   ollama pull qwen3:8b
# LLM_MODEL=qwen3:8b
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1   # Ollama (default)
# OPENAI_BASE_URL=http://host.docker.internal:1234/v1    # LM Studio
# OPENAI_API_KEY=                                         # only if your server requires one
